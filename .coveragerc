[run]
source = app
# omit 的每一项都必须写明理由和退场条件,否则覆盖率数字就是靠排除撑起来的。
# 判据:一次性运维脚本(人工执行、执行完即失效)可排除;有专属测试的业务代码不可排除。
omit =
    # 一次性回填脚本,已执行完毕,保留仅为留档
    app/backfill_question_hashes.py
    # 种子数据,内容即断言(跑一遍就知道对不对),测试价值低于维护成本
    app/seed.py
    # 一次性迁移脚本,2026-09 已实际执行并对账;退场时连同 PyMySQL 一起删
    app/migrate_mysql_to_pg.py
# 注:app/import_question_banks.py 曾被 omit,但它有 tests/test_import_question_banks.py
# 的专属覆盖(解析状态机、LLM 改编、重试兜底),排除它是不成立的,已移出。

[report]
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
