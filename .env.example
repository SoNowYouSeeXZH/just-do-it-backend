# 这是"配置模板"文件,可以安全提交到 git。
# 使用时:复制一份改名为 .env,再填入真实的值。.env 本身不会被提交(见 .gitignore)。

# 大模型 API Key(从智谱开放平台 bigmodel.cn 控制台创建后粘贴到这里)
LLM_API_KEY=your-llm-api-key

# 大模型服务地址(智谱开放平台的 OpenAI 兼容接口)
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 使用的模型名称(GLM-4.7-Flash,免费模型,200K 上下文)
LLM_MODEL=glm-4.7-flash

# 题库批量写入接口鉴权 Key（请替换为随机高强度字符串）
ADMIN_API_KEY=replace-with-a-random-admin-key

# ===== 运行环境 =====
# development:开放 /docs、/redoc、/openapi.json，方便本地调试
# production：关闭上述文档路由，避免接口结构对外暴露
ENVIRONMENT=development
# 开发环境可以自动建表；生产必须设为 false，并在启动前执行 alembic upgrade head
AUTO_CREATE_TABLES=true
# 日志级别与慢请求阈值
LOG_LEVEL=INFO
SLOW_REQUEST_MS=500

# ===== 登录鉴权（JWT）=====
# 签发 token 的密钥，必须换成随机高强度字符串，泄露等于任何人都能伪造登录态。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-jwt-secret
# token 有效期（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== PostgreSQL(Docker compose 会用它初始化)=====
# compose 的 postgres 服务用这组值初始化超级用户/数据库
POSTGRES_USER=justdoit_app
POSTGRES_PASSWORD=replace-with-a-postgres-password
POSTGRES_DB=personal_ai
# 本地直跑(uvicorn/alembic/脚本)时连 127.0.0.1;
# 容器内的 backend 由 compose 的 environment 覆盖为服务名 "postgres"
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ===== 缓存(Redis)=====
# false 时所有缓存调用直接落库，排查"是不是缓存导致的数据不一致"时很有用
CACHE_ENABLED=true
# host 必须是 compose 里的服务名 "redis"
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# 即使 Redis 只在内网，也建议配密码：内网不等于可信，
# 无密码的 Redis 一旦被访问到，可以被写 crontab、传 SSH 公钥。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=
# 缓存基础存活时间（秒）。内容类数据变更少，5 分钟足够挡住重复查询
CACHE_TTL_SECONDS=300
# 空结果的存活时间（秒）。它只是防穿透的挡板，不是真数据，要短
CACHE_NULL_TTL_SECONDS=30
# Redis 连接/读写超时（秒）。必须小：缓存卡住时应快速降级查库，
# 否则加了缓存反而比不加更慢
REDIS_TIMEOUT_SECONDS=0.5
