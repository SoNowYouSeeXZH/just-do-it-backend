# 这是"配置模板"文件,可以安全提交到 git。
# 使用时:复制一份改名为 .env,再填入真实的值。.env 本身不会被提交(见 .gitignore)。

# 大模型 API Key(从智谱开放平台 bigmodel.cn 控制台创建后粘贴到这里)
LLM_API_KEY=your-llm-api-key

# 大模型服务地址(智谱开放平台的 OpenAI 兼容接口)
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 使用的模型名称(GLM-4.7-Flash,免费模型,200K 上下文)
LLM_MODEL=glm-4.7-flash

# 题库批量写入接口鉴权 Key（请替换为随机高强度字符串）
ADMIN_API_KEY=replace-with-a-random-admin-key

# ===== 运行环境 =====
# development:开放 /docs、/redoc、/openapi.json，方便本地调试
# production：关闭上述文档路由，避免接口结构对外暴露
ENVIRONMENT=development
# 开发环境可以自动建表；生产必须设为 false，并在启动前执行 alembic upgrade head
AUTO_CREATE_TABLES=true
# 日志级别与慢请求阈值
LOG_LEVEL=INFO
SLOW_REQUEST_MS=500

# ===== 登录鉴权（JWT）=====
# 签发 token 的密钥，必须换成随机高强度字符串，泄露等于任何人都能伪造登录态。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-jwt-secret
# token 有效期（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== MySQL(Docker compose 会用它初始化)=====
# root 密码：只用于数据库管理和容器健康检查，应用不再用它连库。
MYSQL_ROOT_PASSWORD=replace-with-a-root-password
# 应用的数据库名,容器首次启动时会自动创建
MYSQL_DATABASE=personal_ai
# backend 连数据库时用的主机/端口/账号密码
# host 必须是 compose 里的服务名 "mysql"(容器间靠这个 DNS 名互通)
MYSQL_HOST=mysql
MYSQL_PORT=3306
# 应用专用账号（非 root）。MySQL 官方镜像首次初始化时会创建它，
# 并只授予 MYSQL_DATABASE 这一个库的权限。密码要和 root 密码不同。
MYSQL_USER=justdoit_app
MYSQL_PASSWORD=replace-with-an-app-password
