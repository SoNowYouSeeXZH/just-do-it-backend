# Python 运行时产生的缓存
__pycache__/
*.pyc

# 虚拟环境目录(本地不用 Docker 直接跑时会用到)
.venv/
venv/

# 真实的环境变量文件,绝对不能提交到 git(里面有密钥)
.env

# macOS 系统文件
.DS_Store

# pytest 缓存
.pytest_cache/
.coverage
htmlcov/

# TLS 私钥和证书,只在服务器上生成,绝不进版本库
nginx/certs/*
!nginx/certs/.gitkeep

# AI 协作产生的评审/编排记录,每次运行都会新增一份,不进版本库。
# 需要长期留档的结论请手工整理进 docs/。
summaries/

# 数据库备份。含真实用户数据,绝不进版本库。
# 备份方法见 docs/deployment-and-migrations.md 的「备份与恢复」。
backups/
